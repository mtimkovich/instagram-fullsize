{
	"name": "Full Size IG Right Click",
	"description": "Right click Instagram photos to view or save full size images",
	"version": "0.0.0.5",
	"manifest_version": 3,
	"icons": {
		"16": "/icons/icon16.png",
		"32": "/icons/icon32.png",
		"48": "/icons/icon48.png",
		"64": "/icons/icon64.png",
		"128": "/icons/icon128.png"
	},
	"action":{
		"default_icon": "/icons/icon128.png"
	},
	"permissions": [
		"tabs",
		"contextMenus"
	],
	"host_permissions": [
		"*://*.instagram.com/*"
	],
	"background": {
		"service_worker": "background.js"
	}
}
